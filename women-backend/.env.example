# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Never commit your real secret key to version control.
SECRET_KEY=CHANGE_ME_generate_with_python3_c_import_secrets_print_secrets_token_hex_32

# PostgreSQL connection string.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://womens_health_app:yourpassword@localhost:5432/womens_health

# MySQL alternative (install pymysql and uncomment):
# DATABASE_URL=mysql+pymysql://womens_health_app:yourpassword@localhost:3306/womens_health

# ─── APPLICATION ─────────────────────────────────────────────────────────────

APP_ENV=development       # development | production
DEBUG=true                # Set to false in production

# Comma-separated list of allowed CORS origins (your Next.js frontend URL)
CORS_ORIGINS=http://localhost:3000

# ─── JWT ─────────────────────────────────────────────────────────────────────

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours
REFRESH_TOKEN_EXPIRE_MINUTES=10080 # 7 days
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# ─── FILE UPLOADS ────────────────────────────────────────────────────────────

UPLOAD_DIR=./storage/uploads/acne_images
REPORT_DIR=./storage/reports
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# ─── ML MODEL PATHS ──────────────────────────────────────────────────────────

ML_TEXT_MODELS_DIR=./app/ml/artifacts/text
ML_IMAGE_MODEL_PATH=./app/ml/artifacts/image/mobilenetv2_skin_severity.keras

# ─── EMAIL (for forgot-password) ─────────────────────────────────────────────
# Leave EMAIL_ENABLED=false for local development — the reset link will be
# logged to the server console instead of emailed.

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=no-reply@yourapp.com
FRONTEND_RESET_URL=http://localhost:3000/reset-password
